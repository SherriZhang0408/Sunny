{
  "name": "实验室巡检 Agent",
  "description": "演示用对等 Agent：只查询目录里已登记的采集能力，自己不调模型、不建任务。",
  "version": "0.1.0",
  "documentationUrl": "https://sunny.internal.example/docs/specs/sunny-card",
  "provider": {
    "organization": "科沃斯 / 实验室",
    "url": "https://lab.internal.example/"
  },
  "supportedInterfaces": [
    {
      "url": "https://lab.internal.example/sunny/v1",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extendedAgentCard": false,
    "extensions": [
      {
        "uri": "https://sunny.local/extensions/card/v0.1",
        "description": "SUNNY 企业扩展。",
        "required": true
      }
    ]
  },
  "securitySchemes": {
    "sunnyTicket": {
      "type": "http",
      "scheme": "Bearer",
      "bearerFormat": "SUNNY-TICKET",
      "description": "短时调用票，票不写在本名片内。"
    }
  },
  "security": [
    {
      "sunnyTicket": []
    }
  ],
  "defaultInputModes": ["application/json"],
  "defaultOutputModes": ["application/json"],
  "skills": [
    {
      "id": "catalog.lookup",
      "name": "目录探查",
      "description": "按 skill 或 tag 向 SUNNY 查询已登记只读能力，并把结果回给调用方。",
      "tags": ["catalog", "readonly", "demo"],
      "examples": ["谁会查 living_room 余量"],
      "inputModes": ["application/json"],
      "outputModes": ["application/json"],
      "x-sunny": {
        "data_class": "internal",
        "side_effects": "read",
        "invoke": {
          "method": "POST",
          "path": "/sunny/invoke/catalog.lookup"
        },
        "when_not_to_use": ["直接调模型或创建标注任务"],
        "input_schema": {
          "type": "object",
          "required": ["query"],
          "additionalProperties": false,
          "properties": {
            "query": { "type": "string", "minLength": 1 },
            "skill_id": { "type": "string" },
            "trace_id": { "type": "string" }
          }
        },
        "output_schema": {
          "type": "object",
          "required": ["ready", "mock", "hits", "trace_id"],
          "additionalProperties": false,
          "properties": {
            "ready": { "type": "boolean" },
            "mock": { "type": "boolean" },
            "hits": { "type": "array" },
            "trace_id": { "type": "string" }
          }
        }
      }
    }
  ],
  "x-sunny": {
    "agent_id": "lab.inspector",
    "workspace": "ecovacs.lab",
    "discovery": "registered_peers",
    "access_tier": "S0",
    "lifecycle": "draft",
    "invoke_auth": "sunny_ticket",
    "invoke_identity": "agent_service",
    "scratch_access": "none",
    "not_exposed": ["model.invoke", "hermes.chat"],
    "contact": {
      "owner": "实验室",
      "channel": "internal"
    },
    "notes": "仅用于 Hub 演示互发现与调用关系，不是生产租户。"
  }
}
